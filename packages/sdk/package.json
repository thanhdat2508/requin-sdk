{
  "name": "@requin/sdk",
  "version": "0.0.1",
  "description": "SDK for connect your project to Requin",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@requin/core": "workspace:*",
    "@requin/mcp": "workspace:*",
    "tsup": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0"
}
